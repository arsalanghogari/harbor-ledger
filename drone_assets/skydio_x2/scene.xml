<mujoco model="Skydio X2 scene">
  <include file="x2.xml"/>

  <statistic meansize=".05"/>

  <visual>
    <headlight diffuse=".6 .6 .6" ambient=".3 .3 .3" specular="0 0 0"/>
    <rgba haze=".15 .25 .35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient"
             rgb1=".25 .35 .55" rgb2=".02 .03 .08" width="512" height="3072"/>
    <texture name="groundplane" type="2d" builtin="checker"
             rgb1=".18 .2 .23" rgb2=".08 .1 .12" width="512" height="512"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="8 8" reflectance=".15"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 .05" type="plane" material="groundplane"/>
  </worldbody>
</mujoco>
